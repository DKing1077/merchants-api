# =========================================================
# Suspicious / Review Flow tests
# =========================================================

# Flag a payment intent for review
curl -X POST "http://127.0.0.1:8000/v1/payment_intents/pi_1/flag" \
  -H "Content-Type: application/json" \
  -d '{
    "reason": "amount looks suspicious"
  }'

# List flagged payment intents
curl "http://127.0.0.1:8000/v1/payment_intents/admin/flagged"

# Approve a flagged payment intent
curl -X POST "http://127.0.0.1:8000/v1/payment_intents/admin/pi_1/review" \
  -H "Content-Type: application/json" \
  -d '{
    "review_status": "approved"
  }'

# Reject a flagged payment intent
curl -X POST "http://127.0.0.1:8000/v1/payment_intents/admin/pi_1/review" \
  -H "Content-Type: application/json" \
  -d '{
    "review_status": "rejected"
  }'

# Try to confirm a rejected payment intent
# Expected: HTTP 409 conflict
curl -X POST "http://127.0.0.1:8000/v1/payment_intents/pi_1/confirm"

