# =========================================================
# Ledger API tests
# =========================================================

# IMPORTANT:
# Create ledger accounts first directly in Postgres before testing ledger entries.
# These IDs are used in the curl requests below.

# Insert 2 test ledger accounts
psql -U postgres -d merchants -c "
INSERT INTO ledger_accounts (id, merchant_id, account_type, currency, created_at)
VALUES
  ('cash_account_1', 'm_123', 'cash', 'USD', NOW()),
  ('payable_account_1', 'm_123', 'payable', 'USD', NOW());
"

# Create a balanced ledger entry
curl -X POST "http://127.0.0.1:8000/v1/ledger/entries" \
  -H "Content-Type: application/json" \
  -d '{
    "entry_type": "payment_succeeded",
    "reference_id": "pay_123",
    "description": "Test payment",
    "entry_metadata": {
      "provider": "stripe"
    },
    "postings": [
      {
        "account_id": "cash_account_1",
        "amount": 10000,
        "currency": "USD"
      },
      {
        "account_id": "payable_account_1",
        "amount": -10000,
        "currency": "USD"
      }
    ]
  }'

# Get balance for cash account
curl "http://127.0.0.1:8000/v1/ledger/accounts/cash_account_1/balance"

# Get balance for payable account
curl "http://127.0.0.1:8000/v1/ledger/accounts/payable_account_1/balance"

# Failure test: unbalanced ledger entry
curl -X POST "http://127.0.0.1:8000/v1/ledger/entries" \
  -H "Content-Type: application/json" \
  -d '{
    "entry_type": "payment_succeeded",
    "reference_id": "pay_124",
    "description": "Bad test payment",
    "entry_metadata": {
      "provider": "stripe"
    },
    "postings": [
      {
        "account_id": "cash_account_1",
        "amount": 10000,
        "currency": "USD"
      },
      {
        "account_id": "payable_account_1",
        "amount": -9000,
        "currency": "USD"
      }
    ]
  }'

